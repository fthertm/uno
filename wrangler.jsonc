/**
 * One Worker serves everything: the built client through the Assets binding,
 * plus /api/* and /ws. One `wrangler deploy`, one origin, no CORS.
 *
 * https://cloudflare.com
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "uno",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-05",

	"routes": [
		{ "pattern": "misantropic.net/uno", "zone_name": "misantropic.net" },
		{ "pattern": "misantropic.net/uno/*", "zone_name": "misantropic.net" }
	],

	"workers_dev": false,

	"assets": {
		"not_found_handling": "single-page-application",
		"binding": "ASSETS",
		"run_worker_first": true
	},

	/** One Durable Object instance per room — the DO *is* the game. */
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOM",
				"class_name": "Room"
			}
		]
	},

	/** SQLite-backed classes are the ones available on the free plan. */
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Room"]
		}
	],

	"observability": {
		"enabled": true
	},
	"upload_source_maps": true
}
